# ===== Device identity =====
# No device identity in env anymore: the calling device is identified by the
# device_id claim of its Bearer token (decoded per request).

# ===== API auth (matches admin panel backend2) =====
# Shared HS256 secret used to verify incoming Bearer tokens. Same value as
# backend2/.env JWT_SECRET so device-service accepts the same tokens.
JWT_SECRET=CHANGE_ME

# ===== Remote (shared) PostgreSQL =====
# Same database as the admin panel backend. Handles sync from device to server.
REMOTE_DATABASE_URL=postgresql://neondb_owner:npg_OEZyPCsXWk36@ep-hidden-silence-b4jn87gq-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ===== Payment provider (matches admin panel) =====
# stub = local mock | commerce = Arna Commerce Core API (Xendit hosted checkout)
PAYMENT_PROVIDER=stub

# ===== Arna Payment service (PAYMENT_PROVIDER=commerce) =====
# Plan & price ids are synced onto the campaigns table by backend2
# (campaign.payment_plan_id / payment_price_id); no manual mapping needed.
# Auth forwards the caller's existing Bearer token; organization_id is decoded
# from that token's JWT payload. The kiosk polls POST /payments/{id}/refresh
# until the visitor pays on the hosted Xendit page.
PAYMENT_BASE_URL=https://product.arnatech.id/api/v1
PAYMENT_PRODUCT_ID=98d14061-9e07-403e-b1ea-cde54d2dab76
COMMERCE_BASE_URL=https://product.arnatech.id/api/v1
COMMERCE_TIMEOUT_SECONDS=30
# Placeholder until the kiosk collects a real visitor email.
COMMERCE_PAYER_EMAIL=kiosk@example.com
# Sent to Xendit as invoice redirect targets (untrusted signal only).
COMMERCE_SUCCESS_URL=https://product.arnatech.id/payment/success
COMMERCE_FAILURE_URL=https://product.arnatech.id/payment/failed
# Legacy fallback, only used when a campaign has no synced payment ids.
# Maps local campaign_id -> Commerce catalog UUIDs.
# Example: {"<campaign_id>": {"product": "<uuid>", "plan": "<uuid>", "price": "<uuid>", "description": "Photobooth Single Print"}}
COMMERCE_OFFERS_JSON={}

# ===== Storage service (file upload API, matches admin panel backend2) =====
STORAGE_BASE_URL=https://storage.arnatech.id

# ===== SSO (device authorization API, proxy to https://sso.arnatech.id/swagger) =====
SSO_BASE_URL=https://sso.arnatech.id/api

# ===== Twilio WhatsApp (POST /whatsapp/send) =====
# The kiosk only ever sends the approved content template below; the message
# body is fixed server-side and the kiosk only supplies placeholder values.
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
# whatsapp:+<E.164>. The Twilio sandbox number only reaches recipients who joined
# the sandbox; replace with the production WhatsApp sender when provisioned.
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
# Template content SID (Twilio Console -> Messaging > Content Templates).
TWILIO_WHATSAPP_CONTENT_SID=HXd3d932e8cb4598189831c97250c43d17
TWILIO_TIMEOUT_SECONDS=20

APP_VERSION=0.1.0