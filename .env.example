# ===== Device identity =====
# DEVICE_ID and DEVICE_CODE must match a registered device in the admin panel.
# Leave DEVICE_ID empty to auto-generate a new id on first run.
DEVICE_ID=a5f7c286-50b0-5fad-a005-c6de922b2fbe
DEVICE_CODE=PHB-001
DEVICE_NAME=Demo PHB-001

# ===== Remote (shared) PostgreSQL =====
# Same database as the admin panel backend. Handles sync from device to server.
REMOTE_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ourlilphotobooth2

# ===== Local SQLite (offline-first) =====
LOCAL_DB_PATH=device.db

# ===== Sync behaviour =====
SYNC_INTERVAL_SECONDS=30
SYNC_ON_STARTUP=true

# ===== Payment provider (matches admin panel) =====
PAYMENT_PROVIDER=stub

APP_VERSION=0.1.0